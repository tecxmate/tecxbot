# Tecxbot environment.
#
# Split deliberately into two halves, because they want different homes:
#
#   SECRETS        ~31 credentials. These belong in a secrets manager, synced
#                  from there into the deployment. Leaking one is an incident.
#   CONFIGURATION  everything else — ids, model names, feature flags, limits.
#                  Not sensitive; safe to read, commit, and discuss in a ticket.
#
# Two-thirds of this file is configuration, so keeping the halves apart is what
# makes the credential inventory small enough to actually manage.
#
# Every secret below is FAIL-CLOSED: with it unset, the feature it gates does
# nothing rather than doing something insecure.
#
# The split is enforced by the smoke suite: a credential-shaped name below the
# secrets:end marker fails CI, and so does a variable the code reads that is not
# declared anywhere in this file.


# =============================================================================
# SECRETS — put these in the vault, never in the repo
# =============================================================================
# --- secrets:start ---

# Claude connector. Gates /api/mcp and /api/export — read access to every
# captured client conversation. Rotate this first if anything leaks.
CONNECTOR_TOKEN=
# Neon Postgres. Everything durable depends on this: conversations, notes,
# transcripts, digests. Without it the stores fall back to per-instance memory
# that vanishes. Contains the password inline — never echo it.
CONNECTOR_DATABASE_URL=
# Fallback the SQL layer reads when CONNECTOR_DATABASE_URL is unset. Same
# sensitivity — a database URL with the password inline.
DATABASE_URL=
# Authorizes every scheduled job on /api/cron. All six refuse to run without it.
CRON_SECRET=

# Speech-to-text. The Deepgram key needs at least the MEMBER role: a
# scope-restricted key transcribes but cannot mint the browser upload token
# (403 on /v1/auth/grant). Present and valid is not the same as sufficient.
DEEPGRAM_API_KEY=
# Gates /api/transcribe, /transcribe.html and /api/deepgram-token. Generate with
# openssl rand -hex 32. Must match the value pasted into the upload page.
TRANSCRIBE_SECRET=

# LINE — one access token + channel secret per channel.
TECXMATE_LINE_CHANNEL_ACCESS_TOKEN=
TECXMATE_LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
VN_LINE_CHANNEL_ACCESS_TOKEN=
VN_LINE_CHANNEL_SECRET=
CLAUDE_ASSISTANT_LINE_CHANNEL_ACCESS_TOKEN=
CLAUDE_ASSISTANT_LINE_CHANNEL_SECRET=
# Lets the local coding agent push into the client LINE group without ever
# holding a LINE token — a credential broker in miniature. Unset = endpoint off.
TECXMATE_PUSH_SECRET=

# Meta — WhatsApp Cloud API and Messenger.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=

# Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_SECRET=

# Model providers — metered, so a leak costs money. Note the connector does NOT
# need ANTHROPIC_API_KEY: Claude reasons on your own plan, not through a key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cloudflare R2 — durable media, so images outlive LINE's retention window.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Task trackers. OPS_GITHUB_TOKEN carries repo write access — scope it to the
# minimum repo set. LINEAR_API_KEY is legacy (tracking is Jira now); if nothing
# depends on it, revoking it is a free reduction in surface.
OPS_GITHUB_TOKEN=
LINEAR_API_KEY=
# A bare OAuth access token — it expires; not a durable credential.
GOOGLE_TASKS_ACCESS_TOKEN=

# --- secrets:end ---


# =============================================================================
# CONFIGURATION — not sensitive
# =============================================================================

# ---- LINE: default channel ----
LINE_WEBHOOK_URL=https://your-domain.vercel.app/api/line-webhook
LINE_RICH_MENU_IMAGE_PATH=assets/line-rich-menu.svg
DEFAULT_LINE_CHANNEL_ID=default-line

# ---- LINE: tecxmate client channel ----
# Webhook URL: https://your-domain.vercel.app/api/line-webhook?channel=tecxmate
#
# Capture-only by default: the bot NEVER posts in LINE (no join welcome, no task
# menus, no auto-replies) — it silently feeds the Claude connector, and the PM
# works from Claude Desktop. Set to false to restore the legacy tappable
# task-dispatch bot (tag the bot in a group to dispatch a Linear task).
TECXMATE_CAPTURE_ONLY=true
TECXMATE_COMPANY_NAME=TECXMATE
TECXMATE_BOT_MENTION_NAMES=tecxmate,tecx,bot
# LINE user ids allowed to dispatch tasks. Empty = personal deployment (anyone
# who can tag the bot is treated as the owner).
TECXMATE_OWNER_USER_IDS=

# ---- LINE: Vietnamy teacher bot ----
# Webhook URL: https://your-domain.vercel.app/api/line-webhook?channel=vn-teacher
VN_APP_NAME=Vietnamy
VN_APP_TAGLINE=
VN_APP_URL=https://vietnamy.com
VN_BOT_MENTION_NAMES=vietnamy,teacher,vnmy,bot
OPENAI_TEACHER_MODEL=gpt-4o-mini

# ---- LINE: Claude assistant ("Claude in LINE") ----
# Tag the bot and it answers from the captured client conversation. Registered
# only when its access token is set. See docs/claude-connector.md.
# Webhook URL: .../api/line-webhook?channel=claude-assistant
CLAUDE_ASSISTANT_NAME=TECXMATE
CLAUDE_ASSISTANT_BOT_MENTION_NAMES=tecxmate,mate,bot
# LINE user ids allowed to invoke Claude. Empty = anyone who can tag it.
CLAUDE_ASSISTANT_OWNER_USER_IDS=
# false (default): answers only in the 1:1 owner chat, never client-visible.
# true: also replies inline in groups, Slack-style (client sees the AI).
CLAUDE_ASSISTANT_ALLOW_GROUPS=false
CLAUDE_ASSISTANT_SYSTEM_PROMPT=
CLAUDE_ASSISTANT_CONTEXT_CONVERSATION_ID=
CLAUDE_ASSISTANT_CONTEXT_MESSAGES=40
# Requires ANTHROPIC_API_KEY and CONNECTOR_DATABASE_URL for real context.

# ---- Meta: Messenger ----
FB_WEBHOOK_URL=https://your-domain.vercel.app/api/facebook-webhook
FB_BOT_MENTION_NAMES=tecxbot,tecxmate
FB_OPS_SUMMARY_RECIPIENT_ID=
# The Meta webhook (Messenger + WhatsApp) fails closed when no app secret is
# configured. Set to true ONLY for local testing to accept unsigned payloads.
META_ALLOW_UNSIGNED=false

# ---- Meta: WhatsApp Business ----
# Capture-only, feeds the same connector.
# Webhook URL: https://your-domain.vercel.app/api/whatsapp-webhook
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_PHONE_NUMBER=
WHATSAPP_TENANT_ID=
WHATSAPP_CHANNEL_ID=default-whatsapp

# ---- Telegram ----
TELEGRAM_WEBHOOK_URL=https://your-domain.vercel.app/api/telegram-webhook

# ---- Claude connector ----
# See docs/claude-connector.md, and docs/tutorial.md for how it is used.
# Pin the connector to a single tenant. When set, the caller-supplied tenant_id
# is ignored, so a token on a shared database cannot read other tenants' chats.
# Leave unset for a single-owner deployment.
CONNECTOR_TENANT_ID=
# Override only for a non-Neon SQL-over-HTTP proxy.
CONNECTOR_SQL_ENDPOINT=
# Render connector timestamps in local time, e.g. Asia/Taipei. Default UTC.
CONNECTOR_TIMEZONE=
# Set to false to stop capturing conversations without removing the endpoints.
CONNECTOR_CAPTURE=true
# Days of history to keep. The connector-prune cron job deletes older messages.
# 0 disables pruning. Default 90 when unset and the job is invoked.
CONNECTOR_RETENTION_DAYS=90

# ---- TECXMATE PM (optional push tiers) ----
# Let a connected Claude (on your own plan, no ANTHROPIC_API_KEY) act as the
# project manager for a LINE group. See docs/tecxmate-pm.md. By DEFAULT the PM
# drafts its reply in the Claude chat for you to send yourself (zero LINE quota)
# — the vars below only matter if you also want it to push to LINE.
# Fail-closed: the write tool is neither advertised nor callable unless this is
# exactly "true".
CONNECTOR_ALLOW_REPLY=false
# Comma-separated conversation ids the PM may reply to. Empty = any captured LINE
# conversation. Set it to just the client group to scope the write surface.
CONNECTOR_REPLY_CONVERSATION_IDS=
CONNECTOR_REPLY_SENDER_NAME=TECXMATE PM
# Review / draft-for-approval mode. Set this to an INTERNAL group's conversation
# id and send_line_reply no longer messages the client at all — it posts the
# draft into this group for a human to approve and deliver. Enforced: in review
# mode there is no path from the PM to a client conversation. Find the id via
# the connector's list_conversations. Example:
# CONNECTOR_REVIEW_CONVERSATION_ID=line:tecxmate:group:Cxxxxxxxxxxxxxxxx
CONNECTOR_REVIEW_CONVERSATION_ID=
# Monthly LINE push cap — a hard backstop on quota. Every send_line_reply call is
# one LINE push, and LINE's free tier is limited (~200/month in Taiwan). Set a
# positive integer and the tool refuses once that many pushes are used in the
# current (UTC) month, telling Claude to draft in chat instead. 0 / unset = no cap.
CONNECTOR_REPLY_MONTHLY_CAP=
# Daily reminder brief. Set this to an INTERNAL LINE group's conversation id and
# the daily-brief cron pushes reminders that are due/overdue to that group each
# morning. Fail-closed: unset = the job does nothing. It pushes ONLY when
# something is due, and every push counts against the cap above. Independent of
# CONNECTOR_ALLOW_REPLY — notifying yourself is not the same permission as
# writing to a client.
CONNECTOR_BRIEF_CONVERSATION_ID=

# ---- Cloudflare R2 ----
# Without the credentials above, media is served live from LINE (recent only).
# The archive-media cron job stores media here; get_image / get_file then read
# from R2. Create an R2 API token: Cloudflare → R2 → Manage API Tokens.
# Set R2_ACCOUNT_ID, or R2_ENDPOINT directly.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=

# ---- Task trackers ----
OPS_GITHUB_REPOS=tecxmate/tecxcorp
OPS_REPO_ALIASES=company-os=tecxmate/tecxcorp
OPS_GITHUB_LABELS=ops-task,from-messenger
OPS_GITHUB_DEFAULT_ASSIGNEES=
OPS_ALLOW_UNTAGGED_MESSENGER=false
OPS_DAILY_REPORT_SEND=false
GOOGLE_TASKS_LIST_ID=@default
# Linear is the legacy task bus between the bot (cloud) and the agent (local).
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=
LINEAR_LABEL_IDS=
LINEAR_DEFAULT_ASSIGNEE_ID=

# ---- Models ----
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_OPS_MODEL=gpt-4o-mini
CLAUDE_DAILY_MODEL=claude-3-5-sonnet-latest
# Older aliases, still read as fallbacks by the code.
ANTHROPIC_MODEL=
OPENAI_SUMMARY_MODEL=

# ---- Per-channel tenant / channel ids ----
# Each bot channel resolves to a tenant id and a channel id; these override the
# defaults (which are the channel's own name).
TECXMATE_TENANT_ID=
TECXMATE_LINE_CHANNEL_ID=
VN_TENANT_ID=
VN_LINE_CHANNEL_ID=
CLAUDE_ASSISTANT_TENANT_ID=
CLAUDE_ASSISTANT_LINE_CHANNEL_ID=

# ---- Runtime / tenancy ----
DEFAULT_TENANT_ID=demo
BOT_SYSTEM_KIND=group_translator
MCP_ENDPOINT=
MCP_SYSTEM_PROMPT=
MCP_ALLOWED_TOOLS=
MCP_AGENT_WRITE_USER_IDS=
MCP_AGENT_ALLOW_WRITES_WITHOUT_USER_ALLOWLIST=false
MCP_AGENT_SYNC_PERSONAL_WATCH_TO_SHARED=false

# ---- Billing / public pages (translation-bot scaffold) ----
FREE_CHARACTER_LIMIT=5000
PAID_PLAN_NAME=Team
PAID_CHARACTER_LIMIT=100000
PUBLIC_BASE_URL=https://your-domain.vercel.app
PUBLIC_PRICING_URL=https://your-domain.vercel.app/#pricing
