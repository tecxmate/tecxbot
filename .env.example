# Tecxmate client bot — separate LINE channel that fronts client groups.
# Webhook URL: https://your-domain.vercel.app/api/line-webhook?channel=tecxmate
#
# Capture-only by default: the bot NEVER posts in LINE (no join welcome, no task
# menus, no auto-replies) — it silently feeds the Claude connector, and the PM
# works from Claude Desktop. Set to false to restore the legacy tappable
# task-dispatch bot (tag the bot in a group to dispatch a Linear task).
TECXMATE_CAPTURE_ONLY=true
TECXMATE_LINE_CHANNEL_ACCESS_TOKEN=
TECXMATE_LINE_CHANNEL_SECRET=
TECXMATE_COMPANY_NAME=TECXMATE
TECXMATE_BOT_MENTION_NAMES=tecxmate,tecx,bot
# LINE user ids allowed to dispatch tasks. Empty = personal deployment (anyone
# who can tag the bot is treated as the owner).
TECXMATE_OWNER_USER_IDS=
# Secret the local tecxcorp agent uses to call POST /api/tecxmate-push.
# If unset, the push endpoint is disabled (fails closed).
TECXMATE_PUSH_SECRET=

# Linear is the task bus between the bot (cloud) and the agent (local).
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=
LINEAR_LABEL_IDS=
LINEAR_DEFAULT_ASSIGNEE_ID=

OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_OPS_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_DAILY_MODEL=claude-3-5-sonnet-latest
DEEPGRAM_API_KEY=
DEFAULT_TENANT_ID=demo
DEFAULT_LINE_CHANNEL_ID=default-line
BOT_SYSTEM_KIND=group_translator
MCP_ENDPOINT=
MCP_SYSTEM_PROMPT=
MCP_ALLOWED_TOOLS=
MCP_AGENT_WRITE_USER_IDS=
MCP_AGENT_ALLOW_WRITES_WITHOUT_USER_ALLOWLIST=false
MCP_AGENT_SYNC_PERSONAL_WATCH_TO_SHARED=false
FREE_CHARACTER_LIMIT=5000
PAID_PLAN_NAME=Team
PAID_CHARACTER_LIMIT=100000
PUBLIC_BASE_URL=https://your-domain.vercel.app
PUBLIC_PRICING_URL=https://your-domain.vercel.app/#pricing

# Claude connector — exposes captured LINE/WhatsApp client conversations to
# Claude over MCP at /api/mcp. See docs/claude-connector.md.
# Fails closed: with no CONNECTOR_TOKEN the endpoint refuses every request.
CONNECTOR_TOKEN=
# Postgres for durable conversation history. Without it the connector falls back
# to an in-memory store that only lives for one serverless instance.
CONNECTOR_DATABASE_URL=
# Pin the connector to a single tenant. When set, the caller-supplied tenant_id
# is ignored, so a token on a shared database cannot read other tenants' chats.
# Leave unset for a single-owner deployment.
CONNECTOR_TENANT_ID=
# Override only for a non-Neon SQL-over-HTTP proxy.
CONNECTOR_SQL_ENDPOINT=
# Render connector timestamps in local time, e.g. Asia/Taipei. Default UTC.
CONNECTOR_TIMEZONE=
# Set to false to stop capturing conversations without removing the endpoints.
CONNECTOR_CAPTURE=true
# Days of history to keep. The connector-prune cron job deletes older messages.
# 0 disables pruning. Default 90 when unset and the job is invoked.
CONNECTOR_RETENTION_DAYS=90

# TECXMATE PM — let a connected Claude (Claude Desktop / Claude Code, on your own
# plan, no ANTHROPIC_API_KEY) act as the project manager for a LINE group. See
# docs/tecxmate-pm.md. By DEFAULT the PM drafts its reply in the Claude chat for
# you to send yourself (zero LINE quota) — the vars below only matter if you also
# want it to push to LINE via the send_line_reply tool.
# Fail-closed: the write tool is neither advertised nor callable unless this is
# exactly "true". Leave unset to keep the connector fully read-only (draft-in-chat
# still works — it uses only the read tools).
CONNECTOR_ALLOW_REPLY=false
# Comma-separated conversation ids the PM may reply to. Empty = any captured LINE
# conversation. Set it to just the client group to scope the write surface.
CONNECTOR_REPLY_CONVERSATION_IDS=
# Display name recorded for the PM's outbound replies. Default "TECXMATE PM".
CONNECTOR_REPLY_SENDER_NAME=TECXMATE PM
# Review / draft-for-approval mode. Set this to an INTERNAL group's conversation
# id (e.g. a "tecx-exec" group the bot is in) and send_line_reply no longer
# messages the client at all — it posts the draft into this group for a human to
# approve and deliver. Enforced: in review mode there is no path from the PM to a
# client conversation. Leave unset for direct send. Find the id via the
# connector's list_conversations. Example:
# CONNECTOR_REVIEW_CONVERSATION_ID=line:tecxmate:group:Cxxxxxxxxxxxxxxxx
CONNECTOR_REVIEW_CONVERSATION_ID=
# Monthly LINE push cap — a hard backstop on quota. Every send_line_reply call is
# one LINE push, and LINE's free tier is limited (~200/month in Taiwan). Set a
# positive integer and the tool refuses once that many pushes are used in the
# current (UTC) month, telling Claude to draft in chat instead. 0 / unset = no cap.
CONNECTOR_REPLY_MONTHLY_CAP=

# Cloudflare R2 — durable storage for images and files, so they outlive LINE's
# short media-retention window. Without these, media is served live from LINE
# (recent only). The archive-media cron job stores media here; get_image /
# get_file then read from R2. Create an R2 API token: Cloudflare → R2 → Manage
# API Tokens. Set R2_ACCOUNT_ID (or R2_ENDPOINT directly).
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# WhatsApp Business (Meta Cloud API) — capture-only, feeds the same connector.
# Webhook URL: https://your-domain.vercel.app/api/whatsapp-webhook
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DISPLAY_PHONE_NUMBER=
WHATSAPP_TENANT_ID=
WHATSAPP_CHANNEL_ID=default-whatsapp
# The Meta webhook (Messenger + WhatsApp) fails closed when no app secret is
# configured. Set to true ONLY for local testing to accept unsigned payloads.
META_ALLOW_UNSIGNED=false

# Claude assistant bot — "Claude in LINE" (the tecxbot answer to Claude Tag).
# Tag the bot and it answers from the captured client conversation. Registered
# only when its access token is set. See docs/claude-connector.md.
# Webhook URL: https://your-domain.vercel.app/api/line-webhook?channel=claude-assistant
CLAUDE_ASSISTANT_LINE_CHANNEL_ACCESS_TOKEN=
CLAUDE_ASSISTANT_LINE_CHANNEL_SECRET=
CLAUDE_ASSISTANT_NAME=TECXMATE
CLAUDE_ASSISTANT_BOT_MENTION_NAMES=tecxmate,mate,bot
# LINE user ids allowed to invoke Claude. Empty = anyone who can tag it.
CLAUDE_ASSISTANT_OWNER_USER_IDS=
# false (default): answers only in the 1:1 owner chat, never client-visible.
# true: also replies inline in groups, Slack-style (client sees the AI).
CLAUDE_ASSISTANT_ALLOW_GROUPS=false
# Optional overrides.
CLAUDE_ASSISTANT_SYSTEM_PROMPT=
CLAUDE_ASSISTANT_CONTEXT_CONVERSATION_ID=
CLAUDE_ASSISTANT_CONTEXT_MESSAGES=40
# Requires ANTHROPIC_API_KEY (above) and CONNECTOR_DATABASE_URL for real context.

CRON_SECRET=
OPS_GITHUB_TOKEN=
OPS_GITHUB_REPOS=tecxmate/tecxcorp
OPS_REPO_ALIASES=company-os=tecxmate/tecxcorp
OPS_GITHUB_LABELS=ops-task,from-messenger
OPS_GITHUB_DEFAULT_ASSIGNEES=
OPS_ALLOW_UNTAGGED_MESSENGER=false
GOOGLE_TASKS_ACCESS_TOKEN=
GOOGLE_TASKS_LIST_ID=@default
OPS_DAILY_REPORT_SEND=false
